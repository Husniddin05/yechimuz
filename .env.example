# ===================================================
# YechimUZ Platform - Muhit O'zgaruvchilari (Environment Variables)
# Ushbu fayl namunaviy shablon bo'lib, haqiqiy parollarni o'z ichiga olmaydi.
# Production yoki lokal ishga tushirishda ushbu fayldan nusxa olib, '.env' nomiga o'zgartiring.
# ===================================================

# 1. Ma'lumotlar Bazasi (Database URL)
# Lokal rivojlantirish uchun (SQLite):
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL - Supabase, Neon, Railway yoki VPS):
# DATABASE_URL="postgresql://username:password@localhost:5432/yechimuz_db?schema=public"

# 2. Xavfsizlik va Autentifikatsiya (JWT & NextAuth)
# Kamida 32 ta belgidan iborat tasodifiy xavfsiz kalit kiriting:
JWT_SECRET="your_super_secret_jwt_key_min_32_characters_here"
NEXTAUTH_SECRET="your_nextauth_secret_key_here"

# 3. Sayt Manzili (Application URL)
# Lokal sinov uchun: http://localhost:3000
# Production uchun: https://yechimuz.uz
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Sun'iy Intellekt (Google Gemini API)
# Google AI Studio orqali olingan Gemini API kaliti:
GEMINI_API_KEY="your_google_gemini_api_key_here"
