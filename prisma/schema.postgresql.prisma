datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  phone            String?      @unique
  passwordHash     String
  isVerified       Boolean      @default(false)
  twoFactorEnabled Boolean      @default(false)
  status           String       @default("ACTIVE") // ACTIVE, SUSPENDED, BANNED
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  userRoles        UserRole[]
  profile          Profile?
  problems         Problem[]    @relation("OwnerProblems")
  solutions        Solution[]   @relation("SolverSolutions")
  expertReviews    ExpertReview[] @relation("ExpertReviews")
  shortlists       Shortlist[]  @relation("SelectedShortlists")
  notifications    Notification[]
  auditLogs        AuditLog[]
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique // USER, SOLVER, PROBLEM_OWNER, COMPANY, STARTUP, EXPERT, SPONSOR, MODERATOR, ADMIN, SUPER_ADMIN
  description String?
  userRoles   UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Profile {
  id               String   @id @default(uuid())
  userId           String   @unique
  firstName        String
  lastName         String
  username         String   @unique
  avatarUrl        String?
  bio              String?
  region           String   @default("Farg'ona")
  organizationName String?
  occupation       String?
  skills           String   @default("[]") // JSON string of skills array
  experienceYears  Int      @default(0)
  portfolioUrls    String   @default("[]") // JSON string
  website          String?
  socialLinks      String   @default("{}") // JSON string
  ratingAvg        Float    @default(5.0)
  solvedCount      Int      @default(0)
  impactTotal      Float    @default(0.0)
  badges           String   @default("[]") // JSON string array of earned badge names

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProblemCategory {
  id       String    @id @default(uuid())
  nameUz   String
  nameRu   String?
  nameEn   String?
  slug     String    @unique
  icon     String?
  parentId String?

  problems Problem[]
}

model Problem {
  id             String   @id @default(uuid())
  ownerId        String
  categoryId     String
  title          String
  rawDescription String
  region         String   @default("Farg'ona")
  organization   String?
  problemType    String   @default("GENERAL") // GENERAL, TECHNICAL, AGRICULTURAL, WATER, ECOLOGY
  severityLevel  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  targetResult   String?
  budget         Float    @default(0.0)
  currency       String   @default("UZS")
  deadline       DateTime?
  status         String   @default("PUBLISHED") // DRAFT, PENDING_REVIEW, PUBLISHED, CHALLENGE_READY, IN_PROGRESS, PILOT, SOLVED, CLOSED
  attachments    String   @default("[]") // JSON string array
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner    User            @relation("OwnerProblems", fields: [ownerId], references: [id])
  category ProblemCategory @relation(fields: [categoryId], references: [id])
  challenge Challenge?
}

model Challenge {
  id                 String    @id @default(uuid())
  problemId          String    @unique
  structuredTitle    String
  formattedObjective String
  suggestedSkills    String    @default("[]") // JSON string
  targetKPIs         String    @default("[]") // JSON string
  challengeFormat    String    @default("INNOVATION")
  missingFields      String    @default("[]") // JSON string
  generatedQuestions String    @default("[]") // JSON string
  isOwnerApproved    Boolean   @default(false)
  publishedAt        DateTime  @default(now())

  problem   Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  solutions Solution[]
  shortlists Shortlist[]
  pilots    Pilot[]
}

model Solution {
  id                String   @id @default(uuid())
  challengeId       String
  solverId          String
  title             String
  description       String
  technicalApproach String
  expectedResult    String?
  estimatedCost     Float    @default(0.0)
  estimatedDays     Int      @default(30)
  teamMembers       String   @default("[]") // JSON string
  githubUrl         String?
  demoUrl           String?
  riskAnalysis      String?
  status            String   @default("SUBMITTED") // DRAFT, SUBMITTED, UNDER_REVIEW, SHORTLISTED, REJECTED, SELECTED, PILOT, COMPLETED
  scoreAvg          Float    @default(0.0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  challenge Challenge            @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  solver    User                 @relation("SolverSolutions", fields: [solverId], references: [id])
  attachments SolutionAttachment[]
  reviews   ExpertReview[]
  shortlists Shortlist[]
  pilots    Pilot[]
}

model SolutionAttachment {
  id         String   @id @default(uuid())
  solutionId String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int      @default(0)

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
}

model ExpertReview {
  id                   String   @id @default(uuid())
  solutionId           String
  expertId             String
  innovationScore      Float    @default(0.0) // 1-10
  feasibilityScore     Float    @default(0.0) // 1-10
  costEfficiencyScore  Float    @default(0.0) // 1-10
  impactScore          Float    @default(0.0) // 1-10
  scalabilityScore     Float    @default(0.0) // 1-10
  totalScore           Float    @default(0.0)
  comments             String?
  createdAt            DateTime @default(now())

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  expert   User     @relation("ExpertReviews", fields: [expertId], references: [id])
}

model Shortlist {
  id               String   @id @default(uuid())
  challengeId      String
  solutionId       String
  rankPosition     Int      @default(1)
  shortlistReason  String?
  selectedByUserId String
  createdAt        DateTime @default(now())

  challenge  Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  solution   Solution  @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  selectedBy User      @relation("SelectedShortlists", fields: [selectedByUserId], references: [id])
}

model Pilot {
  id                String        @id @default(uuid())
  challengeId       String
  solutionId        String
  region            String        @default("Farg'ona")
  startDate         DateTime      @default(now())
  endDate           DateTime?
  budget            Float         @default(0.0)
  responsiblePerson String?
  status            String        @default("PLANNED") // PLANNED, APPROVED, RUNNING, EVALUATION, COMPLETED, FAILED
  expectedResult    String?
  actualResult      String?

  challenge Challenge     @relation(fields: [challengeId], references: [id])
  solution  Solution      @relation(fields: [solutionId], references: [id])
  metrics   PilotMetric[]
  impact    ImpactScore?
}

model PilotMetric {
  id                 String   @id @default(uuid())
  pilotId            String
  metricName         String
  expectedValue      String
  actualValue        String
  unit               String?
  verifiedByExpertId String?

  pilot Pilot @relation(fields: [pilotId], references: [id], onDelete: Cascade)
}

model ImpactScore {
  id         String   @id @default(uuid())
  pilotId    String   @unique
  totalScore Float    @default(0.0) // 0-100
  summary    String?

  pilot Pilot @relation(fields: [pilotId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityName String
  entityId   String?
  details    String   @default("{}")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
